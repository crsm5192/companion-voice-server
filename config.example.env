# 桌面伴侣 · 语音服务 —— 环境变量配置模板
# 复制为 .env 或直接在启动前 export / set 这些变量。
# 未设置的项会回退到脚本内的默认值（见 tts_server.py 顶部的路径配置段）。

# ── 工作目录 ────────────────────────────────────────────────
# 服务运行时的工作目录（临时文件、缓存等）
# Windows 默认: C:\voice
# Linux   默认: /opt/voice
VOICE_WORKDIR=/opt/voice

# ── 模型路径 ────────────────────────────────────────────────
# CosyVoice 仓库目录（含 cosyvoice/ 包与 matcha、hifigan 子模块）
VOICE_REPO=/opt/voice/CosyVoice

# CosyVoice3 基座模型目录（含 llm.pt / flow.pt / hift.pt 等）
VOICE_MODEL_DIR=/opt/voice/pretrained_models/CosyVoice3-0.5B

# 音色 LoRA 权重目录（你自己训练的；留空则用基座模型默认音色）
VOICE_LORA_JP=/opt/voice/exp/lora_jp

# ── 参考音频 ────────────────────────────────────────────────
# 纯人声参考池目录（风格/情绪系统依赖）
VOICE_VOCAL_DIR=/mnt/voice/vocals/subaru_vocals

# 兜底参考音频（单条 wav，建议 3~10 秒干净人声）
VOICE_REF_AUDIO=/mnt/voice/vocals/subaru_vocals/ref_0001.wav

# ── 外部工具 ────────────────────────────────────────────────
# ffmpeg 可执行文件路径（用于 wav/mp3 转换、重采样）
FFMPEG=ffmpeg

# ── 服务参数（也可用命令行参数覆盖）──────────────────────────
# 监听端口
PORT=8001
# 空闲多少秒后模型从 GPU 退回 CPU（把显存还给其他程序）
GPU_IDLE_SECONDS=60
# 初始设备：cpu 或 cuda
DEVICE=cpu
